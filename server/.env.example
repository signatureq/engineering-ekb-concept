DJANGO_DEBUG=0
# Generate a unique secret on the server. Never commit the real .env file.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=stroy-ekb.ru,www.stroy-ekb.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://stroy-ekb.ru,https://www.stroy-ekb.ru
CMS_DATA_DIR=/data
PUBLIC_SITE_URL=https://stroy-ekb.ru
# Use 1 while previewing a temporary IP address, then 0 on the final domain.
PUBLIC_SITE_NOINDEX=0
SITE_ADDRESS=stroy-ekb.ru
SITE_ROBOTS_POLICY=all
# Set the real public IPv4 before enabling compose.edge.yaml.
SERVER_IP=203.0.113.10

# FormSubmit recipient. Leave empty to disable; activate the email link before use.
INQUIRY_TO_EMAIL=
